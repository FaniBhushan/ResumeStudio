<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>Resume Studio — Brag Film</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      :root { --bg:#FAFCFB; --ink:#1F2D3D; --green:#18794E; --blue:#2563EB; --muted:#617087; --line:#D8E4DE; --panel:#EEF5F1; --white:#fff; }
      * { box-sizing:border-box; }
      html, body { margin:0; width:100%; height:100%; background:var(--bg); color:var(--ink); font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      #root { position:relative; width:100%; height:100%; overflow:hidden; background:radial-gradient(ellipse at 82% 16%, #E8F3EC 0, transparent 34%), var(--bg); }
      .grain { position:absolute; inset:0; pointer-events:none; opacity:.12; background-image:radial-gradient(#789484 0.65px, transparent .65px); background-size:8px 8px; }
      .brand { position:absolute; left:100px; top:58px; width:300px; height:auto; }
      .top-note { position:absolute; right:108px; top:80px; color:var(--muted); font-size:15px; font-weight:700; letter-spacing:2.6px; }
      .clip { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
      .stage { width:1540px; height:760px; position:relative; display:flex; align-items:center; justify-content:space-between; gap:100px; }
      .copy { width:570px; flex:none; }
      .eyebrow { color:var(--green); text-transform:uppercase; font-size:16px; line-height:1.2; font-weight:800; letter-spacing:3px; margin:0 0 24px; }
      h1 { margin:0; font-size:70px; line-height:1.04; letter-spacing:-3.4px; font-weight:750; }
      h2 { margin:0; font-size:48px; line-height:1.08; letter-spacing:-2px; font-weight:720; }
      .lead { margin:24px 0 0; color:#516171; font-size:23px; line-height:1.48; max-width:520px; }
      .pill-row { display:flex; flex-wrap:wrap; gap:10px; margin-top:30px; }
      .pill { background:#EAF2ED; color:#234735; border:1px solid #D5E6DC; border-radius:999px; padding:10px 16px; font-weight:650; font-size:15px; }
      .window { width:860px; min-height:535px; background:var(--white); border:1px solid #D9E4DE; border-radius:20px; box-shadow:0 30px 80px rgba(31,45,61,.12); overflow:hidden; flex:none; }
      .window-bar { height:48px; background:#F5F8F6; border-bottom:1px solid #E3EAE5; display:flex; align-items:center; padding:0 20px; gap:8px; }
      .dot { width:9px; height:9px; border-radius:50%; background:#C4D0C9; }
      .window-title { margin-left:12px; color:#5E6C78; font-size:13px; font-weight:600; }
      .app-body { display:grid; grid-template-columns:184px 1fr; min-height:486px; }
      .side { background:#F2F7F4; border-right:1px solid #E3EAE5; padding:23px 14px; }
      .side-brand { width:145px; margin:0 auto 28px; display:block; }
      .nav-item { height:38px; display:flex; align-items:center; padding:0 12px; margin:3px 0; border-radius:9px; color:#607080; font-size:13px; font-weight:600; }
      .nav-item.active { background:#DCEFE4; color:#145A3C; }
      .workspace { padding:28px 32px; }
      .page-title { font-size:23px; font-weight:720; letter-spacing:-.5px; margin:0 0 5px; }
      .page-sub { color:#677888; font-size:13px; margin:0 0 22px; }
      .tabs { display:flex; gap:0; border-bottom:1px solid #E3EAE5; margin-bottom:23px; }
      .tab { padding:10px 13px 12px; font-size:12px; color:#6B7887; font-weight:650; white-space:nowrap; }
      .tab.active { color:var(--green); border-bottom:2px solid var(--green); }
      .field-grid { display:grid; grid-template-columns:1fr 1fr; gap:15px; }
      .field { min-height:61px; border:1px solid #D9E3DE; border-radius:9px; padding:10px 13px; background:white; }
      .field label { display:block; color:#687788; font-size:10px; margin-bottom:7px; }
      .field b { font-size:13px; font-weight:600; }
      .field.full { grid-column:1 / -1; min-height:82px; }
      .button { background:var(--green); color:white; border-radius:8px; padding:12px 17px; display:inline-flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top:18px; }
      .button.secondary { color:var(--green); background:#EAF4EE; border:1px solid #D5E6DC; }
      .button.blue { background:var(--blue); }
      .tag { color:#16633F; background:#EAF4EE; padding:6px 9px; border-radius:999px; font-size:11px; font-weight:700; }
      .soft-card { border:1px solid #DCE7E0; border-radius:13px; background:#FBFDFC; padding:19px; }
      .soft-card h3 { margin:0 0 10px; font-size:14px; }
      .small { font-size:12px; color:#617181; line-height:1.5; }
      .check-row { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #E8EEE9; padding:13px 0; font-size:12px; }
      .check-row:last-child { border-bottom:0; }
      .status { color:var(--green); font-weight:700; }
      .toggle { width:42px; height:24px; padding:3px; border-radius:999px; background:#B7C6BD; display:inline-flex; justify-content:flex-start; }
      .toggle.on { background:var(--green); justify-content:flex-end; }
      .toggle span { height:18px; width:18px; border-radius:100%; background:white; }
      .paper { width:330px; min-height:430px; background:#fff; border:1px solid #DDE5E0; box-shadow:0 14px 40px rgba(31,45,61,.09); padding:28px; border-radius:5px; }
      .paper-name { font-size:18px; font-weight:750; border-bottom:2px solid var(--green); padding-bottom:11px; margin-bottom:18px; }
      .paper-line { height:7px; background:#DFE7E2; border-radius:6px; margin:11px 0; }
      .paper-line.short { width:56%; }
      .paper-label { color:var(--green); text-transform:uppercase; letter-spacing:1.6px; font-size:9px; font-weight:800; margin-top:20px; }
      .letter { width:405px; min-height:430px; background:white; border:1px solid #DDE5E0; box-shadow:0 14px 40px rgba(31,45,61,.09); padding:30px; border-radius:5px; }
      .letter p { color:#546474; font-size:12px; line-height:1.7; margin:20px 0; }
      .pair { display:flex; align-items:center; gap:24px; }
      .plus { color:#718477; font-size:28px; font-weight:300; }
      .shadow-word { color:#7F9285; font-size:136px; font-weight:800; position:absolute; right:105px; bottom:28px; letter-spacing:-9px; z-index:0; }
      .stage > * { z-index:1; }
      .centered { display:flex; flex-direction:column; align-items:center; text-align:center; gap:30px; }
      .centered .brand { position:static; width:420px; }
      .hook-card { width:1120px; height:420px; border-radius:26px; border:1px solid #D9E7DE; background:rgba(255,255,255,.82); box-shadow:0 28px 80px rgba(31,45,61,.10); display:flex; align-items:center; justify-content:center; gap:54px; }
      .doc-icon { width:174px; height:210px; border-radius:16px; background:#F0F8F4; border:2px solid #BFD9CA; display:flex; align-items:center; justify-content:center; position:relative; }
      .doc-icon:before { content:""; width:98px; height:132px; border:4px solid var(--green); background:white; border-radius:8px; display:block; }
      .doc-icon:after { content:"✓"; position:absolute; right:21px; bottom:29px; width:50px; height:50px; display:grid; place-items:center; border-radius:50%; background:var(--green); color:white; font-size:25px; }
      .cover-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
      .cover-brand { width:116px; }
      .caption { position:absolute; bottom:63px; left:110px; color:#627486; font-size:14px; letter-spacing:1px; }
    </style>
